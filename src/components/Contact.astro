---
<section id="contact" class="section contact-section">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow eyebrow-gold">Get in Touch</span>
      <h2 class="section-title text-white">Order or Ask Us Anything</h2>
      <p class="section-sub section-sub-light">Delivery-only kitchen • 11 AM – 11 PM daily</p>
    </div>

    <div class="contact-grid">
      <div class="contact-info">
        <div class="contact-row">
          <div class="contact-icon">📍</div>
          <div>
            <h4 class="contact-label">Address</h4>
            <p class="contact-value">
              Shop 8 & 108, Shanti Complex,<br/>
              Near Pramukh Nissan, NH-48,<br/>
              Vapi, Gujarat
            </p>
          </div>
        </div>

        <div class="contact-row">
          <div class="contact-icon">📞</div>
          <div>
            <h4 class="contact-label">Call to Order</h4>
            <a href="tel:+919000000000" class="contact-link">+91 90000 00000</a>
          </div>
        </div>

        <div class="contact-row">
          <div class="contact-icon">🕒</div>
          <div>
            <h4 class="contact-label">Hours</h4>
            <p class="contact-value">Monday – Sunday · 11:00 AM – 11:00 PM</p>
          </div>
        </div>
      </div>

      <form class="contact-form" action="https://formspree.io/f/YOUR_ID" method="POST">
        <div class="form-field">
          <label class="form-label" for="name">Name</label>
          <input id="name" type="text" name="name" required class="form-input" />
        </div>
        <div class="form-field">
          <label class="form-label" for="phone">Phone</label>
          <input id="phone" type="tel" name="phone" required class="form-input" />
        </div>
        <div class="form-field">
          <label class="form-label" for="message">Your Order / Message</label>
          <textarea id="message" name="message" rows="4" required class="form-input"></textarea>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Send Order Request</button>
      </form>
    </div>
  </div>
</section>