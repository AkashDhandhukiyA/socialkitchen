---
---
<div class="form-card">
  <h2 class="form-title">Send Us a Message</h2>
  <p class="form-desc">
    Have a question, feedback, or event enquiry? We'll get back to you.
  </p>

  <form action="https://formspree.io/f/YOUR_ID" method="POST">
    <div class="form-group">
      <label class="form-label" for="name">Full Name</label>
      <input id="name" type="text" name="name" required class="form-input" placeholder="Your name" />
    </div>

    <div class="form-row form-row-2">
      <div class="form-group">
        <label class="form-label" for="phone">Phone</label>
        <input id="phone" type="tel" name="phone" required class="form-input" placeholder="+91 ..." />
      </div>
      <div class="form-group">
        <label class="form-label" for="email">Email (optional)</label>
        <input id="email" type="email" name="email" class="form-input" placeholder="you@example.com" />
      </div>
    </div>

    <div class="form-group">
      <label class="form-label" for="subject">Subject</label>
      <select id="subject" name="subject" class="form-input">
        <option>General enquiry</option>
        <option>Table reservation</option>
        <option>Event booking</option>
        <option>Jain / dietary request</option>
        <option>Feedback</option>
      </select>
    </div>

    <div class="form-group">
      <label class="form-label" for="message">Your Message</label>
      <textarea id="message" name="message" required class="form-input" placeholder="Tell us how we can help..."></textarea>
    </div>

    <button type="submit" class="btn btn-orange btn-lg btn-block">Send Message</button>
  </form>
</div>
