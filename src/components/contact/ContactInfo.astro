---
import Icon from '../Icon.astro';
---
<div class="info-panel">
  <h2 class="info-panel-title">Contact Information</h2>

  <div class="info-item">
    <div class="info-icon ext-style-32"><img src="/images/icon-map.jpg" alt="Map" class="ext-style-36"  width="100" height="100" /></div>
    <div>
      <div class="info-label">Address</div>
      <div class="info-value">
        Shop 8 and 108, Shanti Complex,<br/>
        Near Pramukh Nissan, NH-48,<br/>
        Vapi, Gujarat
      </div>
    </div>
  </div>

  <div class="info-item">
    <div class="info-icon ext-style-33"><img src="/images/icon-phone.jpg" alt="Phone" class="ext-style-37"  width="100" height="100" /></div>
    <div>
      <div class="info-label">Phone</div>
      <div class="info-value"><a href="tel:07567640841">07567640841</a></div>
    </div>
  </div>

  <div class="info-item">
    <div class="info-icon ext-style-34"><img src="/images/icon-mail.jpg" alt="Mail" class="ext-style-38"  width="100" height="100" /></div>
    <div>
      <div class="info-label">Email</div>
      <div class="info-value"><a href="mailto:hello@thesocialkitcchen.in">hello@thesocialkitcchen.in</a></div>
    </div>
  </div>

  <div class="info-item">
    <div class="info-icon ext-style-35"><img src="/images/icon-clock.jpg" alt="Clock" class="ext-style-39"  width="100" height="100" /></div>
    <div>
      <div class="info-label">Hours</div>
      <div class="info-value">
        Lunch 11:00 AM – 3:00 PM<br/>
        Dinner 7:00 PM – 11:00 PM<br/>
        Open all 7 days
      </div>
    </div>
  </div>
</div>

<style>
.ext-style-32 { overflow: hidden; padding: 0; }
.ext-style-33 { overflow: hidden; padding: 0; }
.ext-style-34 { overflow: hidden; padding: 0; }
.ext-style-35 { overflow: hidden; padding: 0; }
.ext-style-36 { width: 100%; height: 100%; object-fit: cover; }
.ext-style-37 { width: 100%; height: 100%; object-fit: cover; }
.ext-style-38 { width: 100%; height: 100%; object-fit: cover; }
.ext-style-39 { width: 100%; height: 100%; object-fit: cover; }
</style>
