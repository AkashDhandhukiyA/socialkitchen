---
import Icon from '../Icon.astro';
---
<div class="info-panel">
  <h2 class="info-panel-title">Contact Information</h2>

  <div class="info-item">
    <div class="info-icon" style="overflow: hidden; padding: 0;"><img src="/images/icon-map.jpg" alt="Map" style="width: 100%; height: 100%; object-fit: cover;" /></div>
    <div>
      <div class="info-label">Address</div>
      <div class="info-value">
        Shop 8 and 108, Shanti Complex,<br/>
        Near Pramukh Nissan, NH-48,<br/>
        Vapi, Gujarat
      </div>
    </div>
  </div>

  <div class="info-item">
    <div class="info-icon" style="overflow: hidden; padding: 0;"><img src="/images/icon-phone.jpg" alt="Phone" style="width: 100%; height: 100%; object-fit: cover;" /></div>
    <div>
      <div class="info-label">Phone</div>
      <div class="info-value"><a href="tel:07567640841">07567640841</a></div>
    </div>
  </div>

  <div class="info-item">
    <div class="info-icon" style="overflow: hidden; padding: 0;"><img src="/images/icon-mail.jpg" alt="Mail" style="width: 100%; height: 100%; object-fit: cover;" /></div>
    <div>
      <div class="info-label">Email</div>
      <div class="info-value"><a href="mailto:hello@thesocialkitcchen.in">hello@thesocialkitcchen.in</a></div>
    </div>
  </div>

  <div class="info-item">
    <div class="info-icon" style="overflow: hidden; padding: 0;"><img src="/images/icon-clock.jpg" alt="Clock" style="width: 100%; height: 100%; object-fit: cover;" /></div>
    <div>
      <div class="info-label">Hours</div>
      <div class="info-value">
        Lunch 11:00 AM – 3:00 PM<br/>
        Dinner 7:00 PM – 11:00 PM<br/>
        Open all 7 days
      </div>
    </div>
  </div>
</div>
