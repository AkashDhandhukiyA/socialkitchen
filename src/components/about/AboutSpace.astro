---
---
<section class="section bg-white ext-style-1">
  <!-- Decorative blob -->
  <div class="ext-style-7"></div>
  
  <div class="container ext-style-2">
    <div class="split-feature">
      <div class="split-feature-image animate-fade-up">
        <img src="/images/interior-bar.webp" alt="The bar area" class="ext-style-8"  width="800" height="600" / srcset="/images/interior-bar.webp 1x, /images/interior-bar.webp 2x">
        
        <!-- Accent graphic -->
        <div class="ext-style-9"></div>
      </div>
      
      <div class="animate-fade-up delay-200">
        <span class="label">Our Space</span>
        <h2 class="section-title ext-style-3">Designed for conversations.</h2>
        <p class="section-sub ext-style-4">
          A vibrant dining room, hand-detailed blue bar, warm brass accents and
          floral murals — we designed every corner to make you want to linger.
        </p>
        
        <div class="ext-style-10">
          <p class="split-feature-quote ext-style-5">
            "We built The Social Kitcchen as a place where food, friends and
            conversations flow freely — a space as vibrant as our flavours."
          </p>
          <div class="split-feature-label ext-style-6">The Social Kitcchen Team</div>
        </div>
        
        <a href="/gallery" class="btn btn-blue btn-lg hover-lift">Explore Gallery</a>
      </div>
    </div>
  </div>
</section>

<style>
.ext-style-1 { position: relative; overflow: hidden; }
.ext-style-2 { position: relative; z-index: 1; }
.ext-style-3 { font-size: clamp(2.5rem, 4vw, 3.5rem); line-height: 1.1; }
.ext-style-4 { margin-bottom: 2rem; }
.ext-style-5 { font-family: var(--font-display); font-size: 1.5rem; font-style: italic; color: var(--blue-deep); margin-bottom: 0.5rem; line-height: 1.4; }
.ext-style-6 { text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.75rem; font-weight: 700; color: var(--text-soft); }
.ext-style-7 { position: absolute; top: -10%; right: -5%; width: 400px; height: 400px; background: var(--orange-light); filter: blur(80px); border-radius: 50%; opacity: 0.3; z-index: 0; }
.ext-style-8 { border-radius: var(--r-xl); box-shadow: var(--sh-xl); }
.ext-style-9 { position: absolute; top: -1rem; left: -1rem; width: 100px; height: 100px; background: url('data:image/svg+xml,%3Csvg width=\'20\' height=\'20\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Ccircle cx=\'2\' cy=\'2\' r=\'2\' fill=\'%230A1F4D\' opacity=\'0.2\'/%3E%3C/svg%3E') repeat; z-index: -1; }
.ext-style-10 { padding-left: 1.5rem; border-left: 3px solid var(--orange); margin-bottom: 2rem; }
</style>
