---
---
<section class="section bg-white" style="position: relative; overflow: hidden;">
  <!-- Decorative blob -->
  <div style="position: absolute; top: -10%; right: -5%; width: 400px; height: 400px; background: var(--orange-light); filter: blur(80px); border-radius: 50%; opacity: 0.3; z-index: 0;"></div>
  
  <div class="container" style="position: relative; z-index: 1;">
    <div class="split-feature">
      <div class="split-feature-image animate-fade-up">
        <img src="/images/interior-bar.jpg" alt="The bar area" style="border-radius: var(--r-xl); box-shadow: var(--sh-xl);" />
        
        <!-- Accent graphic -->
        <div style="position: absolute; top: -1rem; left: -1rem; width: 100px; height: 100px; background: url('data:image/svg+xml,%3Csvg width=\'20\' height=\'20\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Ccircle cx=\'2\' cy=\'2\' r=\'2\' fill=\'%230A1F4D\' opacity=\'0.2\'/%3E%3C/svg%3E') repeat; z-index: -1;"></div>
      </div>
      
      <div class="animate-fade-up delay-200">
        <span class="label">Our Space</span>
        <h2 class="section-title" style="font-size: clamp(2.5rem, 4vw, 3.5rem); line-height: 1.1;">Designed for conversations.</h2>
        <p class="section-sub" style="margin-bottom: 2rem;">
          A vibrant dining room, hand-detailed blue bar, warm brass accents and
          floral murals — we designed every corner to make you want to linger.
        </p>
        
        <div style="padding-left: 1.5rem; border-left: 3px solid var(--orange); margin-bottom: 2rem;">
          <p class="split-feature-quote" style="font-family: var(--font-display); font-size: 1.5rem; font-style: italic; color: var(--blue-deep); margin-bottom: 0.5rem; line-height: 1.4;">
            "We built The Social Kitcchen as a place where food, friends and
            conversations flow freely — a space as vibrant as our flavours."
          </p>
          <div class="split-feature-label" style="text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.75rem; font-weight: 700; color: var(--text-soft);">The Social Kitcchen Team</div>
        </div>
        
        <a href="/gallery" class="btn btn-blue btn-lg hover-lift">Explore Gallery</a>
      </div>
    </div>
  </div>
</section>
