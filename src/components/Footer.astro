---
import Icon from './Icon.astro';

const year = new Date().getFullYear();

const exploreLinks = [
  { href: '/#home',    label: 'Home' },
  { href: '/about',    label: 'Our Story' },
  { href: '/menu',     label: 'Menu Categories' },
  { href: '/gallery',  label: 'Gallery' },
];

const visitLinks = [
  { href: '/reservations', label: 'Book a Table' },
  { href: '/events',       label: 'Private Events' },
  { href: '/contact',      label: 'Contact Us' },
];

const socials = [
  { href: '/contact',                   label: 'Contact Us',icon: 'phone' },
  { href: 'https://instagram.com',      label: 'Instagram', icon: 'ig' },
  { href: 'https://facebook.com',       label: 'Facebook',  icon: 'fb' },
  { href: 'https://wa.me/07567640841', label: 'WhatsApp',  icon: 'wa' },
];
---
<footer class="foot">
  <div class="foot-wrap">
    
    <div class="foot-main">
      
      <!-- Column 1: Brand -->
      <div class="foot-brand-col">
        <a href="/" class="foot-brand">
          <span class="foot-brand-name">The S<em>oo</em>cial Kitcchen</span>
        </a>
        <p class="foot-desc">
          Bold flavours, warm hospitality, and a room designed for conversations. Fresh paneer specials & Asian favourites made daily.
        </p>
      </div>

      <!-- Column 2: Explore -->
      <div class="foot-accordion">
        <button class="foot-col-title" aria-expanded="false">
          <span>Explore</span>
          <span class="foot-icon">+</span>
        </button>
        <nav class="foot-links">
          {exploreLinks.map(l => (
            <a href={l.href} class="foot-link">{l.label}</a>
          ))}
        </nav>
      </div>

      <!-- Column 3: Visit Us -->
      <div class="foot-accordion">
        <button class="foot-col-title" aria-expanded="false">
          <span>Visit Us</span>
          <span class="foot-icon">+</span>
        </button>
        <nav class="foot-links">
          {visitLinks.map(l => (
            <a href={l.href} class="foot-link">{l.label}</a>
          ))}
        </nav>
      </div>
      
    </div>

    <!-- Bottom: Socials & Legal -->
    <div class="foot-bottom">
      
      <div class="foot-socials">
        {socials.map(s => (
          <a
            href={s.href}
            class="foot-social"
            aria-label={s.label}
            target={s.icon !== 'phone' ? "_blank" : undefined}
            rel={s.icon !== 'phone' ? "noopener noreferrer" : undefined}
          >
            <Icon name={s.icon} size={18} />
          </a>
        ))}
      </div>

      <div class="foot-legal">
        <span class="foot-copy">© {year} The Social Kitcchen. All rights reserved.</span>
        <div class="foot-legal-links">
          <a href="#">Privacy Policy</a>
          <a href="#">Terms of Service</a>
        </div>
      </div>
      
    </div>

  </div>
</footer>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const accordions = document.querySelectorAll('.foot-accordion');
    
    accordions.forEach(acc => {
      const btn = acc.querySelector('.foot-col-title');
      if (btn) {
        btn.addEventListener('click', () => {
          // Only toggle on mobile (where max-height styling applies)
          if (window.innerWidth < 900) {
            const isExpanded = btn.getAttribute('aria-expanded') === 'true';
            btn.setAttribute('aria-expanded', !isExpanded);
            
            const icon = btn.querySelector('.foot-icon');
            if (icon) {
              icon.textContent = isExpanded ? '+' : '−';
            }
          }
        });
      }
    });
  });
</script>