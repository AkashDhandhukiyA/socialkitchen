---
---
<section id="home" class="hero">
  <div class="hero-bg">
    <img src="/images/hero.jpg" alt="Paneer butter masala at The Social Kitchen" />
    <div class="hero-overlay"></div>
  </div>

  <div class="container">
    <div class="hero-content animate-fade-up">
      <span class="hero-pill">
        <span class="hero-pill-dot"></span>
        Delivering in Vapi • 4.0 ★
      </span>

      <h1 class="hero-title">
        Bold Flavours,<br/>
        <span class="hero-title-accent">Freshly Delivered.</span>
      </h1>

      <p class="hero-desc">
        Paneer specials, Indian-Chinese classics & hearty North Indian meals —
        cooked to order and delivered hot to your doorstep.
      </p>

      <div class="hero-actions">
        <a href="#menu" class="btn btn-primary">View Menu</a>
        <a href="#contact" class="btn btn-outline-light">Call to Order</a>
      </div>

      <div class="hero-stats">
        <div>
          <div class="hero-stat-value">4.0★</div>
          <div class="hero-stat-label">Delivery Rating</div>
        </div>
        <div>
          <div class="hero-stat-value">69+</div>
          <div class="hero-stat-label">Happy Orders</div>
        </div>
        <div>
          <div class="hero-stat-value">₹400</div>
          <div class="hero-stat-label">Avg. per order</div>
        </div>
      </div>
    </div>
  </div>
</section>