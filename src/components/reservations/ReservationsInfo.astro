---
import Icon from '../Icon.astro';
---
<div class="info-panel">
  <h2 class="info-panel-title">Reservation Info</h2>

  <div class="info-item">
    <div class="info-icon" style="overflow: hidden; padding: 0;"><img src="/images/icon-clock.jpg" alt="Clock" style="width: 100%; height: 100%; object-fit: cover;" /></div>
    <div>
      <div class="info-label">Opening Hours</div>
      <div class="info-value">
        Lunch 11:00 AM – 3:00 PM<br/>
        Dinner 7:00 PM – 11:00 PM<br/>
        Open all 7 days a week
      </div>
    </div>
  </div>

  <div class="info-item">
    <div class="info-icon" style="overflow: hidden; padding: 0;"><img src="/images/icon-phone.jpg" alt="Phone" style="width: 100%; height: 100%; object-fit: cover;" /></div>
    <div>
      <div class="info-label">Call for Large Groups</div>
      <div class="info-value"><a href="tel:07567640841">07567640841</a></div>
    </div>
  </div>

  <div class="info-item">
    <div class="info-icon" style="overflow: hidden; padding: 0;"><img src="/images/icon-map.jpg" alt="Map" style="width: 100%; height: 100%; object-fit: cover;" /></div>
    <div>
      <div class="info-label">Location</div>
      <div class="info-value">
        Shanti Complex, NH-48,<br/>
        Near Pramukh Nissan, Vapi
      </div>
    </div>
  </div>

  <div class="info-item">
    <div class="info-icon" style="overflow: hidden; padding: 0;"><img src="/images/icon-cake.jpg" alt="Cake" style="width: 100%; height: 100%; object-fit: cover;" /></div>
    <div>
      <div class="info-label">Special Occasions</div>
      <div class="info-value">
        Mention birthdays or anniversaries — we'll add a small surprise.
      </div>
    </div>
  </div>
</div>
