---
import Icon from '../Icon.astro';
---
<div class="info-panel">
  <h2 class="info-panel-title">Reservation Info</h2>

  <div class="info-item">
    <div class="info-icon ext-style-53"><img src="/images/icon-clock.webp" alt="Clock" class="ext-style-57"  width="100" height="100" / srcset="/images/icon-clock.webp 1x, /images/icon-clock.webp 2x"></div>
    <div>
      <div class="info-label">Opening Hours</div>
      <div class="info-value">
        Lunch 11:00 AM – 3:00 PM<br/>
        Dinner 7:00 PM – 11:00 PM<br/>
        Open all 7 days a week
      </div>
    </div>
  </div>

  <div class="info-item">
    <div class="info-icon ext-style-54"><img src="/images/icon-phone.webp" alt="Phone" class="ext-style-58"  width="100" height="100" / srcset="/images/icon-phone.webp 1x, /images/icon-phone.webp 2x"></div>
    <div>
      <div class="info-label">Call for Large Groups</div>
      <div class="info-value"><a href="tel:07567640841">07567640841</a></div>
    </div>
  </div>

  <div class="info-item">
    <div class="info-icon ext-style-55"><img src="/images/icon-map.webp" alt="Map" class="ext-style-59"  width="100" height="100" / srcset="/images/icon-map.webp 1x, /images/icon-map.webp 2x"></div>
    <div>
      <div class="info-label">Location</div>
      <div class="info-value">
        Shanti Complex, NH-48,<br/>
        Near Pramukh Nissan, Vapi
      </div>
    </div>
  </div>

  <div class="info-item">
    <div class="info-icon ext-style-56"><img src="/images/icon-cake.webp" alt="Cake" class="ext-style-60"  width="100" height="100" / srcset="/images/icon-cake.webp 1x, /images/icon-cake.webp 2x"></div>
    <div>
      <div class="info-label">Special Occasions</div>
      <div class="info-value">
        Mention birthdays or anniversaries — we'll add a small surprise.
      </div>
    </div>
  </div>
</div>

<style>
.ext-style-53 { overflow: hidden; padding: 0; }
.ext-style-54 { overflow: hidden; padding: 0; }
.ext-style-55 { overflow: hidden; padding: 0; }
.ext-style-56 { overflow: hidden; padding: 0; }
.ext-style-57 { width: 100%; height: 100%; object-fit: cover; }
.ext-style-58 { width: 100%; height: 100%; object-fit: cover; }
.ext-style-59 { width: 100%; height: 100%; object-fit: cover; }
.ext-style-60 { width: 100%; height: 100%; object-fit: cover; }
</style>
