---
const foodImages = [
  { src: '/images/food-biryani.webp',    alt: 'Veg Biryani',           caption: 'Veg Dum Biryani',           size: 'tall' },
  { src: '/images/food-soup.webp',       alt: 'Manchow Soup',          caption: 'Veg Manchow Soup',          size: '' },
  { src: '/images/ood-jeera-rice.webp', alt: 'Jeera Rice',            caption: 'Jeera Rice',                size: '' },
  { src: '/images/food-naan.webp',       alt: 'Butter Naan',           caption: 'Butter Naan',               size: 'wide' },
  { src: '/images/food-chole.webp',      alt: 'Chole with Rice',       caption: 'Chole with Jeera Rice',     size: '' },
  { src: '/images/food-pasta.webp',      alt: 'Alfredo Pasta',         caption: 'Creamy Alfredo Pasta',      size: '' },
  { src: '/images/food-sushi.webp',      alt: 'Sushi Platter',         caption: 'Veg Sushi Platter',         size: '' },
  { src: '/images/dessert-cake.webp',    alt: 'Chocolate Cake',        caption: 'Chocolate Celebration Cake',size: 'tall' },
  { src: '/images/facade.webp',          alt: 'Restaurant Facade',     caption: 'The Social Kitcchen',       size: '' },
];
---
<section class="section bg-cream">
  <div class="container">
    <div class="section-header center">
      <span class="label">The Food</span>
      <h2 class="section-title">From our kitchen.</h2>
      <p class="section-sub">Every dish photographed fresh off the pan.</p>
    </div>

    <div class="gallery-grid">
      {foodImages.map(img => (
        <div class:list={['gallery-item', img.size]}>
          <img src={img.src} alt={img.alt} loading="lazy"  width="800" height="600" />
          <div class="gallery-cap">{img.caption}</div>
        </div>
      ))}
    </div>
  </div>
</section>
