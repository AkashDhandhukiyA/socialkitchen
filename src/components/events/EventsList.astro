---
import Icon from '../Icon.astro';

const events = [
  { icon: '/images/icon-cake.jpg',      title: 'Birthday Celebrations', desc: 'Custom cakes, balloon décor and a dedicated host for your special day.',  img: '/images/dessert-cake.jpg',    guests: '10–40 guests', duration: '2–3 hours', price: 'From ₹8,000' },
  { icon: '/images/icon-briefcase.jpg', title: 'Corporate Dinners',     desc: 'Quiet private room, projector setup and set menus tailored for teams.',  img: '/images/interior-booth.jpg',  guests: '15–50 guests', duration: '2–4 hours', price: 'From ₹12,000' },
  { icon: '/images/icon-heart.jpg',     title: 'Anniversaries',         desc: 'Candle-lit tables, curated menus and romantic music for two.',            img: '/images/interior-floral.jpg', guests: '2–20 guests',  duration: '2 hours',   price: 'From ₹3,000' },
];
---
<section class="section bg-white">
  <div class="container">
    <div class="events-grid">
      {events.map(e => (
        <div class="event hover-lift">
          <img src={e.img} alt={e.title} class="event-image" />
          <div class="event-body">
            <div class="event-icon" style="overflow: hidden; padding: 0;"><img src={e.icon} alt="Icon" style="width: 100%; height: 100%; object-fit: cover;" /></div>
            <h3 class="event-title">{e.title}</h3>
            <p class="event-desc">{e.desc}</p>
            <div class="event-meta">
              <div class="event-meta-item">
                <span class="event-meta-label">Capacity</span>
                <strong>{e.guests}</strong>
              </div>
              <div class="event-meta-item">
                <span class="event-meta-label">Duration</span>
                <strong>{e.duration}</strong>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
