---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar     from '../components/Navbar.astro';
import Footer     from '../components/Footer.astro';
import PageHero   from '../components/shared/PageHero.astro';
import CTASection from '../components/shared/CTASection.astro';

import GalleryAmbience from '../components/gallery/GalleryAmbience.astro';
import GalleryFood     from '../components/gallery/GalleryFood.astro';
---
<BaseLayout
  title="Photo Gallery | The Social Kitcchen - Pure Veg in Vapi"
  description="Explore the photo gallery of The Social Kitcchen in Vapi. View our stunning dining spaces, private event rooms, and beautifully plated pure vegetarian dishes."
>
  <Navbar />

  <PageHero 
    title="Our Gallery" 
    breadcrumbText="Gallery" 
    desc="A visual journey through our space, our dishes and our people." 
  />

  <GalleryAmbience />
  <GalleryFood />

  <CTASection 
    title="Liked what you saw?" 
    sub="Book a table and experience it for yourself." 
  />

  <Footer />
</BaseLayout>