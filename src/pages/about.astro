---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar     from '../components/Navbar.astro';
import Footer     from '../components/Footer.astro';
import PageHero   from '../components/shared/PageHero.astro';
import CTASection from '../components/shared/CTASection.astro';

import AboutStory  from '../components/about/AboutStory.astro';
import AboutValues from '../components/about/AboutValues.astro';
import AboutStats  from '../components/about/AboutStats.astro';
import AboutSpace  from '../components/about/AboutSpace.astro';
---
<BaseLayout
  title="About — The Social Kitcchen Vapi"
  description="Learn about The Social Kitcchen — a modern pure-veg restaurant in Vapi serving bold paneer specials, Indian-Chinese, pasta and sushi."
>
  <Navbar />

  <PageHero 
    title="Our Story" 
    breadcrumbText="About" 
    desc="A restaurant built on bold flavours, warm hospitality and honest cooking." 
  />

  <AboutStory />
  <AboutValues />
  <AboutStats />
  <AboutSpace />

  <CTASection 
    title="Come taste the difference." 
    sub="Book a table and experience freshly cooked food in a stunning setting." 
  />

  <Footer />
</BaseLayout>