---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar     from '../components/Navbar.astro';
import Footer     from '../components/Footer.astro';
import Icon       from '../components/Icon.astro';

const features = [
  { img: '/images/icon-veg.webp',  title: '100% Pure Veg',     desc: 'Every dish is completely vegetarian — including Jain options.' },
  { img: '/images/icon-chef.webp', title: 'Cooked to Order',   desc: 'Nothing sits under a heat lamp. Every dish starts when you order.' },
  { img: '/images/icon-menu.webp', title: 'Multi-Cuisine Menu',desc: 'North Indian, Indo-Chinese, Italian pasta, and Japanese sushi.' },
  { img: '/images/icon-cake.webp', title: 'Events & Parties',  desc: 'Dedicated private spaces for birthdays, anniversaries and corporate dinners.' },
];



const reviews = [
  { name: 'Priya S.', rating: 5, role: 'Regular Guest',  text: 'The paneer butter masala is exceptional — rich, creamy and served hot. Beautiful blue interiors!' },
  { name: 'Rahul M.', rating: 5, role: 'Verified Diner', text: 'Booked the private room for a birthday. Décor, service, food — everything was flawless.' },
  { name: 'Aisha K.', rating: 4, role: 'Jain Diner',     text: 'They prepared Jain dal tadka without onion-garlic without any fuss. Same bold taste.' },
];

const events = [
  { icon: 'cake', title: 'Birthday Celebrations', desc: 'Custom cakes, décor and a dedicated host for your special day.', img: '/images/dessert-cake.webp',    meta: '10–40 guests' },
  { icon: 'work', title: 'Corporate Dinners',     desc: 'Quiet private room, projectors and set menus for teams.',       img: '/images/interior-booth.webp',  meta: '15–50 guests' },
  { icon: 'heart',title: 'Anniversaries',         desc: 'Candle-lit corner tables, curated menus and romantic music.',   img: '/images/interior-floral.webp', meta: '2–20 guests' },
];
---
<BaseLayout preloadImage="/images/hero.webp"
  title="The Social Kitcchen — Pure Veg Restaurant in Vapi"
  description="A modern pure vegetarian restaurant in Vapi serving paneer specials, Indian-Chinese, pasta and sushi. Dine-in & reservations."
>
  <Navbar />

  <!-- HERO -->
  <section class="hero ext-style-1">
    <!-- Decorative blob -->
    <div class="ext-style-40"></div>
    
    <div class="container ext-style-2">
      <div class="hero-inner">
        <div class="hero-content animate-fade-up">

          <h1 class="hero-title">
            Where every meal<br/>
            becomes a <em>memory.</em>
          </h1>

          <p class="hero-desc">
            Bold paneer specials, Indian-Chinese favourites, creamy pastas and
            authentic sushi — served in a vibrant blue-and-brass space.
          </p>

          <div class="hero-actions">
            <a href="/reservations" class="btn btn-orange btn-lg">Book a Table</a>
            <a href="/gallery" class="btn btn-outline btn-lg">View Gallery</a>
          </div>
        </div>

        <div class="hero-visual animate-fade-up delay-200">
          <div class="hero-image ext-style-3">
            <img src="/images/hero.webp" alt="The Social Kitcchen dining hall" class="ext-style-41" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'"  width="1200" height="800" srcset="/images/hero.webp 1x, /images/hero.webp 2x" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- HOURS BAR MARQUEE -->
  <section class="hours-bar marquee-section ext-style-4">
    <div class="marquee-container">
      <div class="marquee-track">
        <!-- Group 1 -->
        <div class="marquee-group">
          <div class="hours-item ext-style-5">
            <div class="hours-icon"><img src="/images/icon-sun.webp" alt="Sun" class="ext-style-42"  width="100" height="100"  loading="lazy" srcset="/images/icon-sun.webp 1x, /images/icon-sun.webp 2x" /></div>
            <div>
              <div class="hours-label ext-style-6">Lunch Service</div>
              <div class="hours-value">11:00 AM – 3:00 PM</div>
            </div>
          </div>
          <div class="hours-item ext-style-7">
            <div class="hours-icon"><img src="/images/icon-moon.webp" alt="Moon" class="ext-style-43"  width="100" height="100"  loading="lazy" srcset="/images/icon-moon.webp 1x, /images/icon-moon.webp 2x" /></div>
            <div>
              <div class="hours-label ext-style-8">Dinner Service</div>
              <div class="hours-value">7:00 PM – 11:00 PM</div>
            </div>
          </div>
          <div class="hours-item ext-style-9">
            <div class="hours-icon"><img src="/images/icon-phone.webp" alt="Phone" class="ext-style-44"  width="100" height="100"  loading="lazy" srcset="/images/icon-phone.webp 1x, /images/icon-phone.webp 2x" /></div>
            <div>
              <div class="hours-label ext-style-10">Reservations</div>
              <div class="hours-value">07567640841</div>
            </div>
          </div>
        </div>
        <!-- Group 2 (Clone for seamless loop) -->
        <div class="marquee-group">
          <div class="hours-item ext-style-11">
            <div class="hours-icon"><img src="/images/icon-sun.webp" alt="Sun" class="ext-style-45"  width="100" height="100"  loading="lazy" srcset="/images/icon-sun.webp 1x, /images/icon-sun.webp 2x" /></div>
            <div>
              <div class="hours-label ext-style-12">Lunch Service</div>
              <div class="hours-value">11:00 AM – 3:00 PM</div>
            </div>
          </div>
          <div class="hours-item ext-style-13">
            <div class="hours-icon"><img src="/images/icon-moon.webp" alt="Moon" class="ext-style-46"  width="100" height="100"  loading="lazy" srcset="/images/icon-moon.webp 1x, /images/icon-moon.webp 2x" /></div>
            <div>
              <div class="hours-label ext-style-14">Dinner Service</div>
              <div class="hours-value">7:00 PM – 11:00 PM</div>
            </div>
          </div>
          <div class="hours-item ext-style-15">
            <div class="hours-icon"><img src="/images/icon-phone.webp" alt="Phone" class="ext-style-47"  width="100" height="100"  loading="lazy" srcset="/images/icon-phone.webp 1x, /images/icon-phone.webp 2x" /></div>
            <div>
              <div class="hours-label ext-style-16">Reservations</div>
              <div class="hours-value">07567640841</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES (from index.astro features array) -->
  <section class="section bg-cream">
    <div class="container">
      <div class="section-header center animate-fade-up">
        <span class="label">Why Dine With Us</span>
        <h2 class="section-title">An experience, not just a meal.</h2>
        <p class="section-sub">
          From the first greeting to the last bite — every detail matters.
        </p>
      </div>

      <div class="grid-4">
        {features.map((f, i) => (
          <div class={`card hover-lift animate-fade-up delay-${(i + 1) * 100}`} class="ext-style-48">
            <div class="ext-style-49">
              <img src={f.img} alt={f.title} loading="lazy" decoding="async" class="ext-style-50" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'"  width="800" height="600" />
            </div>
            <h3 class="card-title ext-style-17">{f.title}</h3>
            <p class="card-desc ext-style-18">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SPLIT FEATURE: OUR SPACE -->
  <section class="section bg-blue-soft ext-style-19">
    <div class="ext-style-51"></div>
    
    <div class="container ext-style-20">
      <div class="split-feature">
        <div class="split-feature-image animate-fade-up">
          <img src="/images/interior-bar.webp" alt="The bar area at The Social Kitcchen" class="ext-style-52" onmouseover="this.style.transform='scale(1.02)'" onmouseout="this.style.transform='scale(1)'"  width="800" height="600"  loading="lazy" srcset="/images/interior-bar.webp 1x, /images/interior-bar.webp 2x" />
        </div>
        <div class="animate-fade-up delay-200">
          <span class="label">Our Space</span>
          <h2 class="section-title">Designed for conversations & celebrations.</h2>
          <p class="section-sub">
            We built The Social Kitcchen as a place where food, friends and
            conversations flow freely — a space as vibrant as our flavours. 
            As a premier pure vegetarian restaurant in Vapi, we pride ourselves on offering a diverse multi-cuisine menu that caters to all tastes, including specialized Jain options.
          </p>
          <p class="section-sub ext-style-21">
            Whether you are joining us for a quick business lunch, an intimate family dinner, or celebrating a milestone in our dedicated private dining spaces, every visit promises impeccable service, freshly prepared dishes, and an unforgettable dining atmosphere.
          </p>
          <p class="split-feature-quote ext-style-22">
            "Good food, great company, and a room that feels like home —
            that's The Social Kitcchen."
          </p>
          <div class="split-feature-label">The Social Kitcchen Team</div>
          <div class="text-center ext-style-23">
            <a href="/about" class="btn btn-orange btn-lg hover-lift ext-style-24">Read Our Story ✨</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- EVENTS -->
  <section class="section bg-cream">
    <div class="container">
      <div class="section-header center">
        <span class="label">Celebrate With Us</span>
        <h2 class="section-title">Private dining & events.</h2>
        <p class="section-sub">From birthdays to corporate dinners — we host it all.</p>
      </div>

      <div class="slider-wrapper">
        <div class="slider-track" id="events-slider">
          {events.map((e, i) => (
            <div class={`slide hover-lift animate-fade-up delay-${(i + 1) * 100}`} class="ext-style-53">
              <div class="ext-style-54">
                <img src={e.img} alt={e.title} loading="lazy" decoding="async" class="ext-style-55" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'"  width="800" height="600" />
              </div>
              <div class="ext-style-56">
                <h3 class="event-title ext-style-25">{e.title}</h3>
                <p class="event-desc ext-style-26">{e.desc}</p>
                <div class="event-meta ext-style-27">
                  <span class="ext-style-57">Capacity:</span>
                  <strong class="ext-style-58">{e.meta}</strong>
                </div>
              </div>
            </div>
          ))}
        </div>
        <div class="slider-controls">
          <div class="slider-dots" id="events-dots"></div>
        </div>
      </div>

      <div class="text-center mt-lg">
        <a href="/events" class="btn btn-blue btn-lg">See All Events →</a>
      </div>
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="section bg-white">
    <div class="container">
      <div class="section-header center">
        <span class="label">Guest Reviews</span>
        <h2 class="section-title">What our guests say.</h2>
        <p class="section-sub">Real experiences from real diners.</p>
      </div>

      <div class="slider-wrapper">
        <div class="slider-track" id="reviews-slider">
          {reviews.map((r, i) => (
            <div class={`review slide hover-lift animate-fade-up delay-${(i + 1) * 100}`} class="ext-style-59">
              <div class="review-quote ext-style-28">"</div>
              <div class="review-stars ext-style-29">
                {Array.from({ length: 5 }).map((_, j) => (
                  <span class={j < r.rating ? '' : 'empty'} class="ext-style-60">★</span>
                ))}
              </div>
              <p class="review-text ext-style-30">{r.text}</p>
              <div class="review-author ext-style-31">
                <div class="review-avatar ext-style-32">{r.name.charAt(0)}</div>
                <div>
                  <div class="review-name ext-style-33">{r.name}</div>
                  <div class="review-role ext-style-34">{r.role}</div>
                </div>
              </div>
            </div>
          ))}
        </div>
        
        <div class="slider-controls">
          <div class="slider-dots" id="slider-dots"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- SEO TEXT CONTENT -->
  <section class="section bg-white" style="padding-top: 0;">
    <div class="container">
      <div class="seo-content" style="max-width: 800px; margin: 0 auto; color: var(--text-soft); line-height: 1.8;">
        <h3 style="color: var(--blue-deep); margin-bottom: 1rem;">Experience the Best Pure Veg Restaurant in Vapi</h3>
        <p style="margin-bottom: 1.5rem;">
          Welcome to The Social Kitcchen, Vapi's premier destination for pure vegetarian dining. We believe that vegetarian food shouldn't be boring, which is why our expert chefs have crafted a dynamic, multi-cuisine menu that brings bold flavors, fresh ingredients, and exceptional culinary techniques to every single plate. Whether you are craving the rich and creamy textures of authentic North Indian curries, the spicy and tangy kicks of Indo-Chinese favorites, or international delights like Italian pasta and Japanese sushi, our kitchen delivers an unforgettable experience tailored to all palates. We also take special care to accommodate dietary preferences, offering an extensive selection of Jain-friendly dishes prepared strictly without onion or garlic, ensuring that everyone can enjoy a fantastic meal without compromise.
        </p>
        <p style="margin-bottom: 1.5rem;">
          Beyond our delicious food, The Social Kitcchen is renowned for its stunning ambiance. Our beautifully designed dining room, featuring deep blue hues, warm brass accents, and a breathtaking floral wall, provides the perfect backdrop for any occasion. From casual family lunches and quick business meetings to romantic dinner dates and large celebrations, our space is designed for conversations and memories. For those looking to host special events, we offer dedicated private dining areas perfect for birthdays, anniversaries, and corporate dinners, complete with customized menus and impeccable service.
        </p>
        <p>
          Conveniently located in the heart of Vapi, we are open seven days a week for both lunch and dinner services. We invite you to join us and discover why locals and visitors alike consider The Social Kitcchen to be a culinary landmark in the city. Walk-ins are always welcome, but we highly recommend reserving a table in advance, especially during the busy weekend hours. Come taste the difference of honest, freshly prepared vegetarian cuisine in a setting that feels just like home.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-cream">
    <div class="container">
      <div class="cta-block glass-panel hover-lift text-center ext-style-35">
        <h2 class="section-title ext-style-36">Reserve your table tonight.</h2>
        <p class="section-sub ext-style-37">Walk-ins welcome, but we recommend booking ahead — especially on weekends.</p>
        <div class="cta-actions ext-style-38">
          <a href="/reservations" class="btn btn-orange btn-lg">Book a Table</a>
          <a href="/contact" class="btn btn-blue btn-lg ext-style-39">
            <Icon name="phone" size={18} /> Contact Us
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

