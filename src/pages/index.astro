---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar     from '../components/Navbar.astro';
import Footer     from '../components/Footer.astro';
import Icon       from '../components/Icon.astro';

const features = [
  { img: '/images/icon-veg.jpg',  title: '100% Pure Veg',     desc: 'Every dish is completely vegetarian — including Jain options.' },
  { img: '/images/icon-chef.jpg', title: 'Cooked to Order',   desc: 'Nothing sits under a heat lamp. Every dish starts when you order.' },
  { img: '/images/icon-menu.jpg', title: 'Multi-Cuisine Menu',desc: 'North Indian, Indo-Chinese, Italian pasta, and Japanese sushi.' },
  { img: '/images/icon-cake.jpg', title: 'Events & Parties',  desc: 'Dedicated private spaces for birthdays, anniversaries and corporate dinners.' },
];



const reviews = [
  { name: 'Priya S.', rating: 5, role: 'Regular Guest',  text: 'The paneer butter masala is exceptional — rich, creamy and served hot. Beautiful blue interiors!' },
  { name: 'Rahul M.', rating: 5, role: 'Verified Diner', text: 'Booked the private room for a birthday. Décor, service, food — everything was flawless.' },
  { name: 'Aisha K.', rating: 4, role: 'Jain Diner',     text: 'They prepared Jain dal tadka without onion-garlic without any fuss. Same bold taste.' },
];

const events = [
  { icon: 'cake', title: 'Birthday Celebrations', desc: 'Custom cakes, décor and a dedicated host for your special day.', img: '/images/dessert-cake.jpg',    meta: '10–40 guests' },
  { icon: 'work', title: 'Corporate Dinners',     desc: 'Quiet private room, projectors and set menus for teams.',       img: '/images/interior-booth.jpg',  meta: '15–50 guests' },
  { icon: 'heart',title: 'Anniversaries',         desc: 'Candle-lit corner tables, curated menus and romantic music.',   img: '/images/interior-floral.jpg', meta: '2–20 guests' },
];
---
<BaseLayout
  title="The Social Kitcchen — Pure Veg Restaurant in Vapi"
  description="A modern pure vegetarian restaurant in Vapi serving paneer specials, Indian-Chinese, pasta and sushi. Dine-in & reservations."
>
  <Navbar />

  <!-- HERO -->
  <section class="hero" style="position: relative;">
    <!-- Decorative blob -->
    <div style="position: absolute; top: -5%; left: -10%; width: 500px; height: 500px; background: var(--blue-soft); filter: blur(100px); border-radius: 50%; opacity: 0.6; z-index: 0;"></div>
    
    <div class="container" style="position: relative; z-index: 1;">
      <div class="hero-inner">
        <div class="hero-content animate-fade-up">

          <h1 class="hero-title">
            Where every meal<br/>
            becomes a <em>memory.</em>
          </h1>

          <p class="hero-desc">
            Bold paneer specials, Indian-Chinese favourites, creamy pastas and
            authentic sushi — served in a vibrant blue-and-brass space.
          </p>

          <div class="hero-actions">
            <a href="/reservations" class="btn btn-orange btn-lg">Book a Table</a>
            <a href="/gallery" class="btn btn-outline btn-lg">View Gallery</a>
          </div>
        </div>

        <div class="hero-visual animate-fade-up delay-200">
          <div class="hero-image" style="border-radius: var(--r-xl); box-shadow: var(--sh-xl); overflow: hidden; transform: scale(1.02);">
            <img src="/images/hero.jpg" alt="The Social Kitcchen dining hall" style="transition: transform 0.8s ease;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- HOURS BAR MARQUEE -->
  <section class="hours-bar marquee-section" style="background: linear-gradient(90deg, var(--blue-deep) 0%, #0A1530 100%); border-top: 1px solid rgba(255,255,255,0.05); border-bottom: 1px solid rgba(255,255,255,0.05); color: var(--white); box-shadow: inset 0 10px 20px rgba(0,0,0,0.2);">
    <div class="marquee-container">
      <div class="marquee-track">
        <!-- Group 1 -->
        <div class="marquee-group">
          <div class="hours-item" style="color: rgba(255,255,255,0.9);">
            <div class="hours-icon"><img src="/images/icon-sun.jpg" alt="Sun" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" /></div>
            <div>
              <div class="hours-label" style="color: var(--orange-light);">Lunch Service</div>
              <div class="hours-value">11:00 AM – 3:00 PM</div>
            </div>
          </div>
          <div class="hours-item" style="color: rgba(255,255,255,0.9);">
            <div class="hours-icon"><img src="/images/icon-moon.jpg" alt="Moon" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" /></div>
            <div>
              <div class="hours-label" style="color: var(--orange-light);">Dinner Service</div>
              <div class="hours-value">7:00 PM – 11:00 PM</div>
            </div>
          </div>
          <div class="hours-item" style="color: rgba(255,255,255,0.9);">
            <div class="hours-icon"><img src="/images/icon-phone.jpg" alt="Phone" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" /></div>
            <div>
              <div class="hours-label" style="color: var(--orange-light);">Reservations</div>
              <div class="hours-value">07567640841</div>
            </div>
          </div>
        </div>
        <!-- Group 2 (Clone for seamless loop) -->
        <div class="marquee-group">
          <div class="hours-item" style="color: rgba(255,255,255,0.9);">
            <div class="hours-icon"><img src="/images/icon-sun.jpg" alt="Sun" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" /></div>
            <div>
              <div class="hours-label" style="color: var(--orange-light);">Lunch Service</div>
              <div class="hours-value">11:00 AM – 3:00 PM</div>
            </div>
          </div>
          <div class="hours-item" style="color: rgba(255,255,255,0.9);">
            <div class="hours-icon"><img src="/images/icon-moon.jpg" alt="Moon" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" /></div>
            <div>
              <div class="hours-label" style="color: var(--orange-light);">Dinner Service</div>
              <div class="hours-value">7:00 PM – 11:00 PM</div>
            </div>
          </div>
          <div class="hours-item" style="color: rgba(255,255,255,0.9);">
            <div class="hours-icon"><img src="/images/icon-phone.jpg" alt="Phone" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" /></div>
            <div>
              <div class="hours-label" style="color: var(--orange-light);">Reservations</div>
              <div class="hours-value">07567640841</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES (from index.astro features array) -->
  <section class="section bg-cream">
    <div class="container">
      <div class="section-header center animate-fade-up">
        <span class="label">Why Dine With Us</span>
        <h2 class="section-title">An experience, not just a meal.</h2>
        <p class="section-sub">
          From the first greeting to the last bite — every detail matters.
        </p>
      </div>

      <div class="grid-4">
        {features.map((f, i) => (
          <div class={`card hover-lift animate-fade-up delay-${(i + 1) * 100}`} style="background: var(--white); border: 1px solid rgba(0,0,0,0.05); text-align: center; padding: 1.5rem;">
            <div style="border-radius: 50%; overflow: hidden; width: 100px; height: 100px; margin: 0 auto 1.5rem auto; box-shadow: var(--sh-md);">
              <img src={f.img} alt={f.title} style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'" />
            </div>
            <h3 class="card-title" style="font-size: 1.25rem; margin-bottom: 0.75rem;">{f.title}</h3>
            <p class="card-desc" style="color: var(--text-soft); line-height: 1.6;">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SPLIT FEATURE: OUR SPACE -->
  <section class="section bg-blue-soft" style="position: relative; overflow: hidden;">
    <div style="position: absolute; top: 10%; right: -5%; width: 400px; height: 400px; background: var(--orange-light); filter: blur(80px); border-radius: 50%; opacity: 0.2; z-index: 0;"></div>
    
    <div class="container" style="position: relative; z-index: 1;">
      <div class="split-feature">
        <div class="split-feature-image animate-fade-up">
          <img src="/images/interior-bar.jpg" alt="The bar area at The Social Kitcchen" style="border-radius: var(--r-xl); box-shadow: var(--sh-xl); transition: transform 0.6s ease;" onmouseover="this.style.transform='scale(1.02)'" onmouseout="this.style.transform='scale(1)'" />
        </div>
        <div class="animate-fade-up delay-200">
          <span class="label">Our Space</span>
          <h2 class="section-title">Designed for conversations.</h2>
          <p class="section-sub">
            We built The Social Kitcchen as a place where food, friends and
            conversations flow freely — a space as vibrant as our flavours.
          </p>
          <p class="split-feature-quote" style="background: rgba(255,255,255,0.5); backdrop-filter: blur(10px); padding: 1.5rem; border-radius: var(--r-md); border-left: 4px solid var(--orange);">
            "Good food, great company, and a room that feels like home —
            that's The Social Kitcchen."
          </p>
          <div class="split-feature-label">The Social Kitcchen Team</div>
          <div class="text-center" style="margin-top: 3rem; position: relative;">
            <a href="/about" class="btn btn-orange btn-lg hover-lift" style="padding-inline: 3rem; box-shadow: 0 10px 20px rgba(242,106,31,0.2);">Read Our Story ✨</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- EVENTS -->
  <section class="section bg-cream">
    <div class="container">
      <div class="section-header center">
        <span class="label">Celebrate With Us</span>
        <h2 class="section-title">Private dining & events.</h2>
        <p class="section-sub">From birthdays to corporate dinners — we host it all.</p>
      </div>

      <div class="slider-wrapper">
        <div class="slider-track" id="events-slider">
          {events.map((e, i) => (
            <div class={`slide hover-lift animate-fade-up delay-${(i + 1) * 100}`} style="background: var(--white); border: 1px solid rgba(0,0,0,0.05); text-align: left; border-radius: var(--r-xl); box-shadow: var(--sh-md); overflow: hidden; display: flex; flex-direction: column;">
              <div style="width: 100%; aspect-ratio: 16/9; overflow: hidden; position: relative;">
                <img src={e.img} alt={e.title} style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'" />
              </div>
              <div style="padding: 2rem;">
                <h3 class="event-title" style="font-size: 1.5rem; margin-bottom: 0.75rem; color: var(--blue-deep);">{e.title}</h3>
                <p class="event-desc" style="color: var(--text-soft); line-height: 1.6; margin-bottom: 1.5rem;">{e.desc}</p>
                <div class="event-meta" style="display: inline-flex; align-items: center; padding: 0.5rem 1rem; background: var(--cream); border-radius: 8px; border: 1px solid rgba(0,0,0,0.05);">
                  <span style="color: var(--orange); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; margin-right: 0.5rem;">Capacity:</span>
                  <strong style="font-size: 0.85rem; color: var(--blue-deep);">{e.meta}</strong>
                </div>
              </div>
            </div>
          ))}
        </div>
        <div class="slider-controls">
          <div class="slider-dots" id="events-dots"></div>
        </div>
      </div>

      <div class="text-center mt-lg">
        <a href="/events" class="btn btn-blue btn-lg">See All Events →</a>
      </div>
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="section bg-white">
    <div class="container">
      <div class="section-header center">
        <span class="label">Guest Reviews</span>
        <h2 class="section-title">What our guests say.</h2>
        <p class="section-sub">Real experiences from real diners.</p>
      </div>

      <div class="slider-wrapper">
        <div class="slider-track" id="reviews-slider">
          {reviews.map((r, i) => (
            <div class={`review slide hover-lift animate-fade-up delay-${(i + 1) * 100}`} style="background: linear-gradient(145deg, rgba(255,255,255,1), rgba(255,255,255,0.7)); backdrop-filter: blur(20px); border: 1px solid rgba(0,0,0,0.05); box-shadow: var(--sh-md); border-radius: var(--r-xl); padding: 2.5rem; position: relative; overflow: hidden;">
              <div class="review-quote" style="position: absolute; top: 1rem; right: 2rem; font-family: var(--font-display); font-size: 6rem; line-height: 1; color: var(--orange); opacity: 0.1; font-weight: 800;">"</div>
              <div class="review-stars" style="margin-bottom: 1.5rem;">
                {Array.from({ length: 5 }).map((_, j) => (
                  <span class={j < r.rating ? '' : 'empty'} style="font-size: 1.25rem;">★</span>
                ))}
              </div>
              <p class="review-text" style="font-size: 1.1rem; line-height: 1.7; color: var(--charcoal); margin-bottom: 2rem; position: relative; z-index: 1;">{r.text}</p>
              <div class="review-author" style="display: flex; align-items: center; gap: 1rem; border-top: 1px solid rgba(0,0,0,0.05); padding-top: 1.5rem; margin-top: auto;">
                <div class="review-avatar" style="width: 48px; height: 48px; border-radius: 50%; background: var(--blue-soft); color: var(--blue-deep); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.25rem;">{r.name.charAt(0)}</div>
                <div>
                  <div class="review-name" style="font-weight: 700; color: var(--blue-deep);">{r.name}</div>
                  <div class="review-role" style="font-size: 0.85rem; color: var(--text-soft); margin-top: 0.25rem;">{r.role}</div>
                </div>
              </div>
            </div>
          ))}
        </div>
        
        <div class="slider-controls">
          <div class="slider-dots" id="slider-dots"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-cream">
    <div class="container">
      <div class="cta-block glass-panel hover-lift text-center" style="padding: 4rem 2rem; border-radius: var(--r-xl); background: linear-gradient(135deg, rgba(255,255,255,0.9), rgba(255,255,255,0.6)); border: 1px solid var(--white);">
        <h2 class="section-title" style="margin-bottom: 1rem;">Reserve your table tonight.</h2>
        <p class="section-sub" style="margin-inline: auto; max-width: 32rem;">Walk-ins welcome, but we recommend booking ahead — especially on weekends.</p>
        <div class="cta-actions" style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-top: 2rem;">
          <a href="/reservations" class="btn btn-orange btn-lg">Book a Table</a>
          <a href="/contact" class="btn btn-blue btn-lg" style="display: flex; align-items: center; gap: 0.5rem;">
            <Icon name="phone" size={18} /> Contact Us
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .slider-wrapper {
    position: relative;
    width: 100%;
    margin-top: 2rem;
  }
  .slider-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    gap: 1.5rem;
    padding-bottom: 2rem;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .slider-track::-webkit-scrollbar { display: none; }
  
  .slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
  }
  @media (min-width: 640px) {
    .slide { flex: 0 0 calc(50% - 0.75rem); }
  }
  @media (min-width: 1024px) {
    .slide { flex: 0 0 calc(33.333% - 1rem); }
  }
  
  .slider-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 1rem;
  }
  
  .slider-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--white);
    border: 1px solid var(--border);
    color: var(--blue-deep);
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: all 0.3s var(--ease);
    box-shadow: var(--sh-sm);
  }
  .slider-btn:hover {
    background: var(--orange);
    color: var(--white);
    border-color: var(--orange);
    transform: translateY(-2px);
  }
  .slider-btn svg { width: 20px; height: 20px; }
  
  .slider-dots {
    display: flex;
    gap: 8px;
  }
  .slider-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--border-dark);
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
  }
  .slider-dot.active {
    background: var(--orange);
    transform: scale(1.3);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    
    function initSlider(trackId, dotsId) {
      const track = document.getElementById(trackId);
      const dotsContainer = document.getElementById(dotsId);
      
      if (!track || !dotsContainer) return;
      
      const slides = track.querySelectorAll('.slide');
      
      // Create dots
      slides.forEach((_, i) => {
        const dot = document.createElement('button');
        dot.className = 'slider-dot';
        if (i === 0) dot.classList.add('active');
        dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
        
        dot.addEventListener('click', () => {
          const slideWidth = slides[0].getBoundingClientRect().width;
          const gap = 24; // 1.5rem gap
          track.scrollTo({ left: i * (slideWidth + gap), behavior: 'smooth' });
        });
        
        dotsContainer.appendChild(dot);
      });
      
      const dots = dotsContainer.querySelectorAll('.slider-dot');
      
      // Update dots on scroll
      track.addEventListener('scroll', () => {
        const slideWidth = slides[0].getBoundingClientRect().width;
        const scrollLeft = track.scrollLeft;
        const activeIndex = Math.round(scrollLeft / slideWidth);
        
        dots.forEach((dot, i) => {
          dot.classList.toggle('active', i === activeIndex);
        });
      });
    }

    initSlider('reviews-slider', 'slider-dots');
    initSlider('events-slider', 'events-dots');
  });
</script>