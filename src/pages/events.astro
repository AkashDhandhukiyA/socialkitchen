---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar     from '../components/Navbar.astro';
import Footer     from '../components/Footer.astro';
import PageHero   from '../components/shared/PageHero.astro';

import EventsList     from '../components/events/EventsList.astro';
import EventsPackages from '../components/events/EventsPackages.astro';
---
<BaseLayout
  title="Events & Private Dining — The Social Kitcchen Vapi"
  description="Host birthdays, corporate dinners and anniversaries at The Social Kitcchen Vapi. Private rooms and pure-veg set menus available."
>
  <Navbar />

  <PageHero 
    title="Events & Private Dining" 
    breadcrumbText="Events" 
    desc="From intimate anniversaries to corporate dinners — we make every occasion memorable." 
  />

  <EventsList />
  <EventsPackages />

  <section class="section bg-white">
    <div class="container">
      <div class="cta-block">
        <h3>Plan your event.</h3>
        <p>Call us or send an enquiry — we'll help design the perfect celebration.</p>
        <div class="cta-actions">
          <a href="/contact" class="btn btn-orange btn-lg">Contact Us</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>