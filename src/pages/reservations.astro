---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar     from '../components/Navbar.astro';
import Footer     from '../components/Footer.astro';
import Icon       from '../components/Icon.astro';
---
<BaseLayout
  title="Reservations — The Social Kitcchen Vapi"
  description="Book a table at The Social Kitcchen Vapi. Lunch 11 AM – 3 PM, Dinner 7 PM – 11 PM. Pure veg. Walk-ins welcome."
>
  <Navbar />

  <section class="page-hero">
    <div class="container">
      <div class="page-hero-inner">
        <div class="page-hero-crumb">
          <a href="/">Home</a>
          <span>/</span>
          <span>Reservations</span>
        </div>
        <h1 class="page-hero-title">Book a Table</h1>
        <p class="page-hero-desc">
          Reserve your spot in under a minute. Walk-ins welcome, but weekends book fast.
        </p>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container">
      <div class="grid-2" style="align-items: flex-start;">
        <div class="info-panel">
          <h2 class="info-panel-title">Reservation Info</h2>

          <div class="info-item">
            <div class="info-icon"><Icon name="clock" /></div>
            <div>
              <div class="info-label">Opening Hours</div>
              <div class="info-value">
                Lunch 11:00 AM – 3:00 PM<br/>
                Dinner 7:00 PM – 11:00 PM<br/>
                Open all 7 days a week
              </div>
            </div>
          </div>

          <div class="info-item">
            <div class="info-icon"><Icon name="phone" /></div>
            <div>
              <div class="info-label">Call for Large Groups</div>
              <div class="info-value"><a href="tel:+919000000000">+91 90000 00000</a></div>
            </div>
          </div>

          <div class="info-item">
            <div class="info-icon"><Icon name="map" /></div>
            <div>
              <div class="info-label">Location</div>
              <div class="info-value">
                Shanti Complex, NH-48,<br/>
                Near Pramukh Nissan, Vapi
              </div>
            </div>
          </div>

          <div class="info-item">
            <div class="info-icon"><Icon name="cake" /></div>
            <div>
              <div class="info-label">Special Occasions</div>
              <div class="info-value">
                Mention birthdays or anniversaries — we'll add a small surprise.
              </div>
            </div>
          </div>
        </div>

        <div class="form-card">
          <h2 class="form-title">Reserve Your Table</h2>
          <p class="form-desc">
            Fill in your details and we'll confirm your reservation within 30 minutes.
          </p>

          <form action="https://formspree.io/f/YOUR_ID" method="POST">
            <div class="form-row form-row-2">
              <div class="form-group">
                <label class="form-label" for="rname">Full Name</label>
                <input id="rname" type="text" name="name" required class="form-input" placeholder="Your name" />
              </div>
              <div class="form-group">
                <label class="form-label" for="rphone">Phone</label>
                <input id="rphone" type="tel" name="phone" required class="form-input" placeholder="+91 ..." />
              </div>
            </div>

            <div class="form-row form-row-3">
              <div class="form-group">
                <label class="form-label" for="rdate">Date</label>
                <input id="rdate" type="date" name="date" required class="form-input" />
              </div>
              <div class="form-group">
                <label class="form-label" for="rtime">Time</label>
                <input id="rtime" type="time" name="time" required class="form-input" />
              </div>
              <div class="form-group">
                <label class="form-label" for="rguests">Guests</label>
                <select id="rguests" name="guests" class="form-input">
                  <option>1 person</option>
                  <option>2 people</option>
                  <option>3 people</option>
                  <option>4 people</option>
                  <option>5 people</option>
                  <option>6 people</option>
                  <option>7–10 people</option>
                  <option>10+ people</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="roccasion">Occasion (optional)</label>
              <select id="roccasion" name="occasion" class="form-input">
                <option>Just dining</option>
                <option>Birthday</option>
                <option>Anniversary</option>
                <option>Date night</option>
                <option>Business dinner</option>
                <option>Family gathering</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="rnotes">Special Requests</label>
              <textarea id="rnotes" name="notes" class="form-input" placeholder="Jain food, window seat, high chair, etc."></textarea>
            </div>

            <button type="submit" class="btn btn-orange btn-lg btn-block">Confirm Reservation</button>

            <div class="form-note">
              <Icon name="clock" size={18} />
              <span>We hold tables for 15 minutes past the reserved time. For large groups (10+), please call us directly.</span>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>