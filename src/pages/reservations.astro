---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar     from '../components/Navbar.astro';
import Footer     from '../components/Footer.astro';
import PageHero   from '../components/shared/PageHero.astro';

import ReservationsInfo from '../components/reservations/ReservationsInfo.astro';
import ReservationsForm from '../components/reservations/ReservationsForm.astro';
---
<BaseLayout
  title="Reservations — The Social Kitcchen Vapi"
  description="Book a table at The Social Kitcchen Vapi. Lunch 11 AM – 3 PM, Dinner 7 PM – 11 PM. Pure veg. Walk-ins welcome."
>
  <Navbar />

  <PageHero 
    title="Book a Table" 
    breadcrumbText="Reservations" 
    desc="Reserve your spot in under a minute. Walk-ins welcome, but weekends book fast." 
  />

  <section class="section bg-white">
    <div class="container">
      <div class="grid-2" style="align-items: flex-start;">
        <ReservationsInfo />
        <ReservationsForm />
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>